#version 430 

/**
 * Multi-modal Shader either:
 * - creating a heightmap
 * - creating a mesh according to the heightmap
 */
#define MODE_COUNT_TRIANGLES 0
#define MODE_GENERATE_TRIANGLES 1
#define MODE_RESET_HEIGHT 2
#define MAX_VALUE 10

#define DISPATCH_SIZE 2
layout(local_size_x = DISPATCH_SIZE, local_size_y = DISPATCH_SIZE) in;

layout(std430, binding = 0) buffer PositionBuffer {
    vec4 Entries[];
} Positions;

layout(std430, binding = 1) buffer NormalBuffer {
    vec4 Entries[];
} Normals;

layout(std430, binding = 2) buffer CountBuffer {
    uint Count;
} Counter;

layout(std430, binding = 3) buffer HeightBuffer {
    uint Value[];
} Heights;

uniform ivec2 _TexSize;
uniform ivec3 _WorldSize;
uniform vec3 _WorldPos;
uniform vec3 _BrushPos;

// 0 = calc overall size, 1 = actually compute vertices
uniform uint _Mode;

const uint VertCount = 6;
const int VertexMapLength = 28;
const int VertexLookupLength0 = 15;
const int VertexLookupLength1 = 48;


