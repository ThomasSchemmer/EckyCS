/**
 * Actual world position for each vertex
 * contains {Xpos, ZPos, HeightLookup}
 * Note: flattened into 1d
 */
const float VertexToWorld[48] = {
    // regular points
    0.0, 1.0, 0.0,
    1.0, 1.0, 1.0,
    0.0, 0.0, 2.0,
    1.0, 0.0, 3.0,
    // in between, first 
    0.5, 1.0, 0.0,
    0.0, 0.5, 0.0,
    1.0, 0.5, 1.0,
    0.5, 0.0, 2.0,
    // in between, last
    0.5, 1.0, 1.0,
    0.0, 0.5, 2.0,
    1.0, 0.5, 3.0,
    0.5, 0.0, 3.0,
    // center for vertex 0, 1, 2, 3
    0.5, 0.5, 0.0,
    0.5, 0.5, 1.0,
    0.5, 0.5, 2.0,
    0.5, 0.5, 3.0
};

int GetHeightID(int Heights[4]){
    int HeightMap[MAX_VALUE];
    for (int i = 0; i < MAX_VALUE; i++){
        HeightMap[i] = -1;
    }

    int CurIndex = 0;
    if (HeightMap[Heights[0]] < 0){
        HeightMap[Heights[0]] = CurIndex;
        CurIndex++;
    }
    if (HeightMap[Heights[1]] < 0){
        HeightMap[Heights[1]] = CurIndex;
        CurIndex++;
    }
    if (HeightMap[Heights[2]] < 0){
        HeightMap[Heights[2]] = CurIndex;
        CurIndex++;
    }
    if (HeightMap[Heights[3]] < 0){
        HeightMap[Heights[3]] = CurIndex;
        CurIndex++;
    }

    // heightMap[0] is always 0!
    int HeightID = HeightMap[Heights[3]] + HeightMap[Heights[2]] * 4 + HeightMap[Heights[1]] * 16;
    return HeightID;
}

/** Uses height interpolation to calculate the resulting WorldPos*/
vec3 GetVertex(int Index, int Heights[4])
{
    int Start = Index * 3;
    vec3 Tmp = vec3(
        VertexToWorld[Start],
        Heights[int(VertexToWorld[Start + 2])],
        VertexToWorld[Start + 1]
    );
    return Tmp;
}

void GenerateTriangles(ivec3 id, int Heights[4], int Start, int End){
    // read the info from the data struct to fill in triangles
    for (int i = Start; i < End; i += 3)
    {
        if (VertexLookup[i] == -1)
            break;

        vec3 A = GetVertex(VertexLookup[i + 0], Heights) + id;
        vec3 B = GetVertex(VertexLookup[i + 1], Heights) + id;
        vec3 C = GetVertex(VertexLookup[i + 2], Heights) + id;
        // scale back down to 1x1x1
        A.y = A.y / (MAX_VALUE - 2) * _WorldSize.y;
        B.y = B.y / (MAX_VALUE - 2) * _WorldSize.y;
        C.y = C.y / (MAX_VALUE - 2) * _WorldSize.y;
        A.xz = A.xz / _TexSize * _WorldSize.xz;
        B.xz = B.xz / _TexSize * _WorldSize.xz;
        C.xz = C.xz / _TexSize * _WorldSize.xz;
        A += _WorldPos;
        B += _WorldPos;
        C += _WorldPos;

        // each triangle has 3 vertices and only 1 normal
        uint Index = atomicAdd(Counter.Count, 3);
        Positions.Entries[Index + 0].xyz = A;
        Positions.Entries[Index + 1].xyz = B;
        Positions.Entries[Index + 2].xyz = C;
        Normals.Entries[Index / 3].xyz = normalize(cross(normalize(A - B), normalize(C - B)));
    }
}

void CountTriangles(ivec3 id, int Heights[4], int Start, int End){
    // to have quick lookup we pad the data with -1 for invalid entries
    // this allows for "jump to entry x", since each have the same length.
    // But: we now need to count how many entries we actually need to avoid a largely empty buffer
    for (int i = Start; i < End; i += 3)
    {
        if (VertexLookup[i] == -1)
            break;

        atomicAdd(Counter.Count, 3);
    }
}

void GenerateHeightMesh(ivec3 id){
    if (_Mode != MODE_COUNT_TRIANGLES && _Mode != MODE_GENERATE_TRIANGLES)
        return;
    
    // height indicates the type of mesh via lookup table
    // clamped to different height "bands"
    int Offset0 = clamp(id.z + 1, 0, _TexSize.y - 1) * _TexSize.x + clamp(id.x + 0, 0, _TexSize.x - 1);
    int Offset1 = clamp(id.z + 1, 0, _TexSize.y - 1) * _TexSize.x + clamp(id.x + 1, 0, _TexSize.x - 1);
    int Offset2 = clamp(id.z + 0, 0, _TexSize.y - 1) * _TexSize.x + clamp(id.x + 0, 0, _TexSize.x - 1);
    int Offset3 = clamp(id.z + 0, 0, _TexSize.y - 1) * _TexSize.x + clamp(id.x + 1, 0, _TexSize.x - 1);
    
    int Height0 = clamp(int(Heights.Value[Offset0]), 0, MAX_VALUE - 1);
    int Height1 = clamp(int(Heights.Value[Offset1]), 0, MAX_VALUE - 1);
    int Height2 = clamp(int(Heights.Value[Offset2]), 0, MAX_VALUE - 1);
    int Height3 = clamp(int(Heights.Value[Offset3]), 0, MAX_VALUE - 1);
        
    int Heights[4] = { Height0, Height1, Height2, Height3 };
    int HeightID = GetHeightID(Heights);
    if (HeightID >= VertexMapLength)
        return;

    int LookupID = VertexMap[HeightID];
    if (LookupID < 0 || LookupID >= VertexLookupLength0)
        return;

    // lookup the blueprint for the structure
    int Start = LookupID * VertexLookupLength1;
    int End = (LookupID + 1) * VertexLookupLength1;
    if (_Mode == MODE_COUNT_TRIANGLES){
        CountTriangles(id, Heights, Start, End);
    }else if (_Mode == MODE_GENERATE_TRIANGLES){
        GenerateTriangles(id, Heights, Start, End);
    }
}

void GenerateTex(ivec3 id){
    if (_Mode != MODE_RESET_HEIGHT)
        return;

    uint GlobalIndex = id.z * _TexSize.x + id.x;
    Heights.Value[GlobalIndex] = 0;
}

void main() {
    if (gl_GlobalInvocationID.x >= _TexSize.x * DISPATCH_SIZE || gl_GlobalInvocationID.y >= _TexSize.y * DISPATCH_SIZE)
        return;
    
    ivec3 id = ivec3(gl_GlobalInvocationID.x, 0, gl_GlobalInvocationID.y);
    
    GenerateTex(id);
    GenerateHeightMesh(id);
}