#version 430 

/**
 * Shader that computes the position of each grass billboard
 * Uses the actual terrain triangle positions that are closest and 
 * interpolates from there
 */

#define MODE_COUNT_TRIANGLES 0
#define MODE_GENERATE_TRIANGLES 1

#define DISPATCH_SIZE 8
layout(local_size_x = DISPATCH_SIZE, local_size_y = DISPATCH_SIZE) in;

layout(std430, binding = 0) buffer PositionBuffer {
    vec4 Entries[];
} Positions;

layout(std430, binding = 1) buffer CountBuffer {
    uint Count;
} Counter;

/** Contains the ordered terrain triangles, see TerrainMesh.comp */
layout(std430, binding = 2) buffer VerticesBuffer {
    vec4 Entries[];
} Vertices;

layout(std430, binding = 3) buffer VertexOffsetsBuffer {
    uint Values[];
} VertexOffsets;

layout(std430, binding = 4) buffer HeightBuffer {
    uint Values[];
} Heights;

// 0 = calc overall size, 1 = actually compute vertices
uniform uint _Mode;
uniform ivec2 _TargetCount;
uniform ivec3 _WorldSize;
uniform vec3 _GlobalWorldPos;
uniform ivec2 _TexSize;
uniform uint _GroupCount;

const uint VertexCount = 24;

#include "COMMON_SHADER"
#include "TERRAIN_COMMON_SHADER"
#include "TERRAIN_CUBIC_SHADER"
#include "TERRAIN_TEXLOOKUP_SHADER"

const vec2 Decorations[] = vec2[](
vec2(LAYOUT_GRASS, DECORATION_CHANCE_GRASS),
vec2(LAYOUT_FLOWER, DECORATION_CHANCE_FLOWER)
);

int GetBaseIndexFor(vec3 id, ivec2 Offset){
    float ClampedID =
        clamp(floor(id.z + float(Offset.y)), 0.0f, _TexSize.y - 1) * _TexSize.x +
        clamp(floor(id.x + float(Offset.x)), 0.0f, _TexSize.x - 1);
    return int(ClampedID);
}

ivec2 GetBaseIDFor(vec3 id, ivec2 Offset){
    vec2 Clamped;
    Clamped.x = clamp(floor(id.x + float(Offset.x)), 0.0f, _TexSize.x - 1);
    Clamped.y = clamp(floor(id.z + float(Offset.y)), 0.0f, _TexSize.y - 1);
    return ivec2(Clamped);
}

ivec3 GetQuadIndexForThreadID(vec3 id){
    // use the world pos to lookup which quad its supposed to reference
    // todo: figure out why this doesnt work "exactly"
    vec2 Scale = vec2(float(_TexSize) / _WorldSize.x, float(_TexSize) / _WorldSize.z);
    vec3 ScaledWorldPos = vec3(id.x * Scale.x, 0, id.z * Scale.y);
    ivec2 BaseID = GetBaseIDFor(ScaledWorldPos, ivec2(0));
    int QuadIndex = GetBaseIndexFor(ScaledWorldPos, ivec2(0));
    return ivec3(QuadIndex, BaseID);
}

vec2 hash2(vec2 p)
{
    uvec2 q = floatBitsToUint(p);
    q *= uvec2(1597334677u, 3812015801u);
    q ^= q >> 16;
    return vec2(q) * (1.0 / 4294967296.0);
}

float GetSideOfTriangle(int IndexInQuad, int StartVertex, vec3 WorldPos)
{
    vec3 Min03 = IndexInQuad == 0 ? Vertices.Entries[StartVertex +  0].xyz : Vertices.Entries[StartVertex + 18].xyz;
    vec3 Max03 = IndexInQuad == 0 ? Vertices.Entries[StartVertex +  5].xyz : Vertices.Entries[StartVertex + 23].xyz;
    vec3 Min12 = IndexInQuad == 1 ? Vertices.Entries[StartVertex +  8].xyz : Vertices.Entries[StartVertex + 14].xyz;
    vec3 Max12 = IndexInQuad == 1 ? Vertices.Entries[StartVertex + 11].xyz : Vertices.Entries[StartVertex + 17].xyz;
    vec3 Min = IndexInQuad == 0 || IndexInQuad == 3 ? Min03 : Min12;
    vec3 Max = IndexInQuad == 0 || IndexInQuad == 3 ? Max03 : Max12;
    
    // calculate the divider line
    vec2 A = vec2(Max.x, Min.z);
    vec2 B = vec2(Min.x, Max.z);
    vec2 AB = B - A;
    AB = vec2(AB.y, -AB.x);
    vec2 APos = vec2(WorldPos.x, WorldPos.z) - A;
    float d = dot(AB, APos);
    // now we can check which side we are on
    float Side = sign(d);
    return Side;
}

vec3 GetBaricentricCoordinates(vec3 WorldPos, vec4 VertA, vec4 VertB, vec4 VertC)
{
    //  get the baricentric coordinates
    vec3 VecAB = (VertB - VertA).xyz;
    vec3 VecAC = (VertC - VertA).xyz;
    vec3 VecAP = WorldPos - VertA.xyz;
    float d00 = dot(VecAB, VecAB);
    float d01 = dot(VecAB, VecAC);
    float d11 = dot(VecAC, VecAC);
    float d20 = dot(VecAP, VecAB);
    float d21 = dot(VecAP, VecAC);
    float Denom = d00 * d11 - d01 * d01;
    float beta = (d11 * d20 - d01 * d21) / Denom;
    float gamma = (d00 * d21 - d01 * d20) / Denom;
    float alpha = 1 - beta - gamma;
    return vec3(alpha, beta, gamma);
}

float GetHeightFromWorldPos(vec3 WorldPos){
    ivec3 QuadIndices = GetQuadIndexForThreadID(WorldPos);
    int QuadIndex = QuadIndices.x;
    ivec2 QuadXY = QuadIndices.yz;
    // since all terrain quadrants have the standard quad at their base, we need to check for offset
    vec2 WorldSizePerQuad = vec2(_WorldSize.x, _WorldSize.z) / vec2(_TexSize);
    vec2 WorldPosOfQuad;
    WorldPosOfQuad.x = WorldSizePerQuad.x * float(QuadXY.x);
    WorldPosOfQuad.y = WorldSizePerQuad.y * float(QuadXY.y);
    
    vec2 WorldPosInQuad = vec2(WorldPos.x, WorldPos.z) - WorldPosOfQuad;
    vec2 WorldPosInQuadPerc = WorldPosInQuad / WorldSizePerQuad;
    
    // for more info on the layout see @TerrainMesh.comp
    // we try to find the quad first, then need to check which triangle of that quad we are in
    int StartVertex = QuadIndex == 0 ? 0 : int(VertexOffsets.Values[QuadIndex - 1]);
    int IndexInQuad = (WorldPosInQuadPerc.x > .5 ? 1 : 0) + (WorldPosInQuadPerc.y > .5 ? 2 : 0);
    
    // unfortunately the order of the triangle in a quadpart is one of two, depending on triangle index
    // so offset from the start depending on which one we are looking at (each quadpart has 2 triangles aka 6 vertices)
    // for that we need to check on which side of the divider line we are on
    float Side = GetSideOfTriangle(IndexInQuad, StartVertex, WorldPos);
    
    // but we still need to invert the order for quads 1 and 2, as they are flipped!
    int TriangleStart = StartVertex + IndexInQuad * 6;
    int SideOffset = (IndexInQuad == 1 || IndexInQuad == 2) ? 3 : 0;
    SideOffset = (Side > 0 ? 3 - SideOffset : SideOffset);
    TriangleStart += SideOffset;
    
    // get the actual triangle positions
    vec4 VertA = Vertices.Entries[TriangleStart + 0];
    vec4 VertB = Vertices.Entries[TriangleStart + 1];
    vec4 VertC = Vertices.Entries[TriangleStart + 2];
    
    vec3 BariCoords = GetBaricentricCoordinates(WorldPos, VertA, VertB, VertC);
    
    // and now we can use that to interpolate the height
    return BariCoords.x * VertA.y + BariCoords.y * VertB.y + BariCoords.z * VertC.y;
}


bool IsOnDirt(vec3 id, ivec3 QuadIndices){
    int QuadIndex = QuadIndices.x;
    ivec2 BaseID = QuadIndices.yz;
    uvec4 TexValues = GetTexValues(QuadIndex, _TexSize);
    float Noise = cubicNoise(id / 2.0);
    float Dirt = GetTexValueByLayout(BaseID, TexValues, LAYOUT_TEX0, Noise);
    Dirt += GetTexValueByLayout(BaseID, TexValues, LAYOUT_TEX1, Noise);
    Dirt += GetTexValueByLayout(BaseID, TexValues, LAYOUT_TEX2, Noise);
    return Dirt > 0.02;
}

uint GetDecorationType(uint Value, float Chance, int DecorationValue){
    vec2 Decoration = Decorations[DecorationValue - 1].xy;
    uint Offset = uint(Decoration.x);
    Value = Value & uint(1 << Offset);
    bool bHasDecoration = Value > 0 ? true : false;
    bool bHasChance = Chance < Decoration.y ? true : false;
    return bHasDecoration && bHasChance ? DecorationValue : 0;
}

uint GetDecorationType(ivec3 QuadIndices, vec3 WorldPos){
    float Chance = cubicNoise(WorldPos);
    Chance = map(Chance, -.34, 1.34, 0, 1);
    uint Values = Heights.Values[QuadIndices.x];
    uint DecorationType = 0;
    DecorationType += GetDecorationType(Values, Chance, DECORATION_GRASS);
    Chance = fract((Chance + 1.36) * 1.94);
    DecorationType += GetDecorationType(Values, Chance, DECORATION_FLOWER);
    return DecorationType;
}

void GenerateGrassPosition(vec3 id){
    // break grid structure with randomness
    uvec2 cell = uvec2(id.xz);
    cell ^= cell.yx * 1664525u;
    vec2 Offset = hash2(vec2(cell)) - .5;
    id.xz += Offset;
    if (id.x < 0 || id.z < 0)
        return;

    vec2 Scale = vec2(_WorldSize.xz) / vec2(_TargetCount);
    vec3 WorldPos = vec3(id.x * Scale.x, 0, id.z * Scale.y);
    float Height = GetHeightFromWorldPos(WorldPos);
    ivec3 QuadIndices = GetQuadIndexForThreadID(id);
    
    uint DecorationType = GetDecorationType(QuadIndices, WorldPos);
    if (DecorationType == 0)
        return;
    
    if (IsOnDirt(WorldPos, QuadIndices))
        return;

    //Todo: check if we not are above water/dirt etc! 

    uint Index = atomicAdd(Counter.Count, 1);
    if (_Mode == MODE_COUNT_TRIANGLES)
        return;

    Positions.Entries[Index].xz = WorldPos.xz;
    Positions.Entries[Index].y = Height;
    Positions.Entries[Index].w = DecorationType - 1;
}

void GenerateGrassPositions(ivec3 id){
    // since we have to generate multiple grasses per thread, we have to 
    // call it in a way that handles leftovers
    int TotalThreadCount = int(_GroupCount * DISPATCH_SIZE);
    ivec2 CountPerThread = ivec2(_TargetCount / float(TotalThreadCount));
    ivec2 LeftOverCount = _TargetCount - CountPerThread * TotalThreadCount;
    
    for (int x = 0; x < CountPerThread.x; x++){
        for (int y = 0; y < CountPerThread.y; y++){
            vec3 Pos = vec3(id.x * CountPerThread.x + x, 0, id.z * CountPerThread.y + y);
            GenerateGrassPosition(Pos);
        }
    }

    ivec2 Offset = TotalThreadCount * CountPerThread;
    if (id.x < LeftOverCount.x){
        vec3 Pos = vec3(id) + vec3(Offset.x, 0, 0);
        GenerateGrassPosition(Pos);
    }
    if (id.z < LeftOverCount.y){
        vec3 Pos = vec3(id) + vec3(0, 0, Offset.y);
        GenerateGrassPosition(Pos);
    }
    if (id.x < LeftOverCount.x && id.z < LeftOverCount.y){
        vec3 Pos = vec3(id) + vec3(Offset.x, 0, Offset.y);
        GenerateGrassPosition(Pos);
    }
}


void main() {
    ivec3 id = ivec3(gl_GlobalInvocationID.x, 0, gl_GlobalInvocationID.y);
    
    GenerateGrassPositions(id);
}